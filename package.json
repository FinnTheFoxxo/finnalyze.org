{
  "name": "finnalyze.org",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/inter": "^5.2.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "astro": "7.4.4",
    "normalize.css": "^8.0.1",
    "satteri": "^0.11.6",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
